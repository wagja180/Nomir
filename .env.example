# نسخ هذا الملف إلى .env وتعبئة القيم الحقيقية. لا ترفع .env إلى git أبداً.

# المنصة المستخدمة (أي منصة يدعمها ccxt، مثل binance)
EXCHANGE_ID=binance

# مفاتيح API الخاصة بالمنصة (اختياري لتحليل السوق فقط، إلزامي للتداول الحقيقي)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# كلمة مرور API إضافية تتطلبها بعض المنصات فقط (مثل OKX وKuCoin)؛
# اتركها فارغة إن كانت منصتك لا تطلبها (مثل Binance)
EXCHANGE_API_PASSPHRASE=

# استخدم testnet/sandbox المنصة بدلاً من الحساب الحقيقي (موصى به للتجربة)
EXCHANGE_SANDBOX=true

# نسبة رأس المال المعرضة للخطر في كل صفقة (مثال: 0.01 = 1%)
RISK_PER_TRADE=0.01

# الحد الأقصى لعدد الصفقات المفتوحة في نفس الوقت
MAX_OPEN_POSITIONS=1

# نسبة المكافأة إلى الخطر المطلوبة لقبول الصفقة (مثال: 2 = الهدف ضعف المسافة إلى وقف الخسارة)
MIN_REWARD_RISK_RATIO=1.5
